# Python -> Simulink UDP sender.
# Python envia top_face_center fisico de la roca: [x,y,z] en metros.
SIMULINK_UDP_ENABLED=1
SIMULINK_UDP_DEST_IP=127.0.0.1
SIMULINK_UDP_DEST_PORT=55001
SIMULINK_UDP_SOURCE_IP=127.0.0.1
SIMULINK_UDP_SOURCE_PORT=55000
SIMULINK_UDP_DATA_TYPE=double
SIMULINK_UDP_BYTE_ORDER=little
SIMULINK_UDP_SEND_ON_HOLD=1
SIMULINK_UDP_MIN_PERIOD_S=0.0

# Referencia para configurar el bloque UDP Receive en Simulink.
SIMULINK_BLOCK_LOCAL_ADDRESS=0.0.0.0
SIMULINK_BLOCK_LOCAL_PORT=55001
SIMULINK_BLOCK_REMOTE_ADDRESS=127.0.0.1
SIMULINK_BLOCK_REMOTE_PORT=55000
SIMULINK_BLOCK_SOURCE_DATA_TYPE=double
SIMULINK_BLOCK_DATA_SIZE=3x1
SIMULINK_BLOCK_BYTE_ORDER=little-endian
SIMULINK_BLOCK_ENABLE_BLOCKING=off
SIMULINK_BLOCK_OUTPUT_LATEST_DATA=on
SIMULINK_BLOCK_SAMPLE_TIME=0.05
